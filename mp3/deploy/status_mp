#!/bin/bash
# One line per VM: is the node process up, its pid, and its last READY line.
# Usage: ./status_mp [vm...|all]   (default all)
. "$(dirname "$0")/lib.sh"
parse_vms "${@:-all}"
one() {
    local n="$1" pid
    pid=$(vm_pid "$n")
    if [ -n "$pid" ]; then
        printf 'VM %-2s UP   pid %-6s %s\n' "$n" "$pid" "$(vm_sh "$n" 'grep "^READY" "$MP3_RUN/node.out" | tail -1 | cut -d" " -f1-4')"
    else
        printf 'VM %-2s DOWN %s\n' "$n" "$(vm_sh "$n" '[ -e "$MP3_RUN/$VMID.db" ] && echo "(database present)" || echo "(no database)"' 2>/dev/null)"
    fi
}
for n in "${VMS[@]}"; do one "$n" & done | sort -k2 -n; wait
