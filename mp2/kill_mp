#!/bin/bash

USER="kbalaji4"

if [ $# -ne 1 ]; then
    echo "Usage: ./kill_mp <vm_number>"
    exit 1
fi

vm_number=$1

if ! [[ "$vm_number" =~ ^[0-9]+$ ]] ||
   [ "$vm_number" -lt 1 ] ||
   [ "$vm_number" -gt 10 ]; then
    echo "VM number must be between 1 and 10"
    exit 1
fi

host_suffix=$((4800 + vm_number))
hostname="fa26-cs425-${host_suffix}.cs.illinois.edu"

pid=$(ssh "${USER}@${hostname}" \
    "pgrep -f \"^python3 node.py ${vm_number}\$\"" 2>/dev/null)

if [ -z "$pid" ]; then
    echo "VM ${vm_number}: node.py is not running"
    exit 0
fi

# Crash the process only. Never remove logs here.
if ! ssh "${USER}@${hostname}" "kill -9 ${pid}"; then
    echo "ERROR: failed to kill VM ${vm_number} PID ${pid}"
    exit 1
fi

sleep 1

remaining_pid=$(ssh "${USER}@${hostname}" \
    "pgrep -f \"^python3 node.py ${vm_number}\$\"" 2>/dev/null)

if [ -z "$remaining_pid" ]; then
    echo "VM ${vm_number}: PID ${pid} killed"
else
    echo "ERROR: VM ${vm_number} is still running as PID ${remaining_pid}"
    exit 1
fi
