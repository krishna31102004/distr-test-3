#!/bin/bash

USER="kbalaji4"
REMOTE_DIR="fa26_cs425_.group-mp_.team-48/mp2"

vm_number=$1
mode=$2

if [ -z "$vm_number" ]; then
    echo "Usage: ./show_mp <vm_number> [-f]"
    exit 1
fi

if ! [[ "$vm_number" =~ ^[0-9]+$ ]] ||
   [ "$vm_number" -lt 1 ] ||
   [ "$vm_number" -gt 10 ]; then

    echo "VM number must be between 1 and 10"
    exit 1
fi

host_suffix=$((4800 + vm_number))
hostname="fa26-cs425-${host_suffix}.cs.illinois.edu"

if [ "$mode" = "-f" ]; then
    ssh -t ${USER}@${hostname} \
        "cd ~/${REMOTE_DIR} && tail -n 80 -f node.out"
else
    ssh ${USER}@${hostname} \
        "cd ~/${REMOTE_DIR} && tail -n 80 node.out"
fi
